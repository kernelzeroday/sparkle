# sparkle RPM spec. scripts/build-rpm.sh fills in the @...@ fields and builds it; the sources
# come from scripts/make-sources.sh, with every crate vendored so the build runs offline.

%global srcid @SRCID@

# The release profile strips symbols, so there is no debug information to package.
%global debug_package %{nil}

%bcond_without check

Name:           sparkle
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Terminal-first chat and prompt tool for language models

# sparkle is Apache-2.0; the rest covers the crates compiled into the binary.
License:        @LICENSE@
URL:            https://github.com/kernelzeroday/sparkle
Source0:        %{srcid}.tar.gz
Source1:        %{srcid}-vendor.tar.gz

# Edition 2024 with let chains; the strictest dependency needs 1.89.
BuildRequires:  rust >= 1.89
BuildRequires:  cargo >= 1.89
# Bundled SQLite and the TLS backends (aws-lc, ring) compile C code.
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  cmake
BuildRequires:  make

@BUNDLED@

%description
sparkle is a terminal-first chat and prompt tool for language models, with a
full-screen chat interface and a pipe-friendly command line. It talks to any
OpenAI-compatible server, local or remote, and keeps conversations in a local
SQLite history.

%prep
%autosetup -n %{srcid}
tar -xzf %{SOURCE1}
mkdir -p .cargo
cat >.cargo/config.toml <<'TOML'
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "vendor"
TOML

%build
export CARGO_HOME="$PWD/.cargo-home"
export RUSTFLAGS="%{?build_rustflags}"
cargo build --release --locked --offline -p sparkle
# Generated by the binary so they always match its flags. HOME keeps it out of the builder's.
mkdir -p generated
export HOME="$PWD/generated/home"
target/release/sparkle man >generated/sparkle.1
target/release/sparkle completions bash >generated/sparkle.bash
target/release/sparkle completions zsh >generated/_sparkle
target/release/sparkle completions fish >generated/sparkle.fish

%install
install -Dpm 0755 target/release/sparkle %{buildroot}%{_bindir}/sparkle
install -Dpm 0644 generated/sparkle.1 %{buildroot}%{_mandir}/man1/sparkle.1
install -Dpm 0644 generated/sparkle.bash %{buildroot}%{_datadir}/bash-completion/completions/sparkle
install -Dpm 0644 generated/_sparkle %{buildroot}%{_datadir}/zsh/site-functions/_sparkle
install -Dpm 0644 generated/sparkle.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/sparkle.fish

%if %{with check}
%check
export CARGO_HOME="$PWD/.cargo-home"
export RUSTFLAGS="%{?build_rustflags}"
export HOME="$PWD/generated/home"
# The library suites run headless. The end-to-end suites drive a pseudo-terminal and a mock
# server, which belong in development rather than a package build.
cargo test --release --locked --offline -p sparkle-core -p sparkle-store -p sparkle-tui
%endif

%files
%license LICENSE
%doc README.md
%{_bindir}/sparkle
%{_mandir}/man1/sparkle.1*
%{_datadir}/bash-completion/completions/sparkle
%dir %{_datadir}/zsh
%dir %{_datadir}/zsh/site-functions
%{_datadir}/zsh/site-functions/_sparkle
%dir %{_datadir}/fish
%dir %{_datadir}/fish/vendor_completions.d
%{_datadir}/fish/vendor_completions.d/sparkle.fish

%changelog
* @DATE@ sparkle contributors <noreply@github.com> - @VERSION@-1
- @CHANGE@
